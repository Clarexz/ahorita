# Copia a .env (no se commitea). En CI estos valores vienen de los secretos de GitHub.
EXPO_PUBLIC_SUPABASE_URL=https://parejas-api.example.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: Client ID OAuth de tipo "Web" de Google Cloud (proyecto app-par-946be). Sin él la app no
# muestra "Continuar con Google". Ver docs/SETUP.md ("Iniciar sesión con Google").
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
